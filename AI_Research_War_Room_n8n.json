    {
      "parameters": {
        "promptType": "define",
        "text": "={{ JSON.stringify({topic: $('Research Brief').item.json.topic, question: $('Research Brief').item.json.research_question, search: $json}) }}",
        "options": {
          "systemMessage": "You are the skeptical researcher in an AI Research War Room. Stress-test the topic using only the supplied search results. Find limitations, counterexamples, risks, failed approaches, contradictory evidence, hype, and claims that are not well supported. Return findings, evidence, source URLs, confidence, and unknowns."
        }
      },
