    {
      "parameters": {
        "jsCode": "const report = $json.output ?? $json.text ?? JSON.stringify($json);\nconst brief = $('Research Brief').first().json;\nreturn [{ json: {\n  title: `AI Research War Room \u2014 ${brief.topic}`,\n  topic: brief.topic,\n  research_question: brief.research_question,\n  audience: brief.audience,\n  generated_at: new Date().toISOString(),\n  report,\n  note: 'Three independent research passes were synthesized: technical, industry, and skeptical.'\n} }];"
      },
