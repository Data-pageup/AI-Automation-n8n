    {
      "parameters": {
        "promptType": "define",
        "text": "={{ JSON.stringify({topic: $('Research Brief').item.json.topic, question: $('Research Brief').item.json.research_question, search: $json}) }}",
        "options": {
          "systemMessage": "You are the technical researcher in an AI Research War Room. Analyze only the supplied search results. Extract concrete claims, technical mechanisms, benchmarks or papers, dates, and source URLs. Separate evidence from inference. Flag weak evidence. Return a concise research memo with: findings, evidence, source URLs, confidence, unknowns."
        }
      },
      "id": "bcf33c9a-a67b-461b-aefa-f494b46c41ca",
      "name": "Technical Research Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        -120,
