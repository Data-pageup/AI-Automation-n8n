    {
      "parameters": {
        "promptType": "define",
        "text": "={{ JSON.stringify({topic: $('Research Brief').first().json.topic, research_question: $('Research Brief').first().json.research_question, audience: $('Research Brief').first().json.audience, independent_memos: $input.all().map(i => i.json.output || i.json.text || i.json)}) }}",
        "options": {
          "systemMessage": "You are the lead researcher. You receive independent technical, industry, and skeptical research memos. Produce a rigorous final research report. Cross-check claims across memos. Do not treat a claim as established merely because one memo says it. Prefer specific evidence and recent sources. Explicitly distinguish: confirmed evidence, reasonable inference, disagreement/uncertainty. Include: executive summary, key findings, technical reality, industry reality, skeptical view, evidence table, implications for the audience, practical recommendations, open questions, and source URLs. No fabricated citations."
        }
      },
      "id": "9ab5e5b8-9fca-4a9e-affc-78057caa4264",
      "name": "War Room Lead Synthesizer",
      "type": "@n8n/n8n-nodes-langchain.agent",
