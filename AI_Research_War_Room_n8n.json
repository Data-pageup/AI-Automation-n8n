    {
      "parameters": {
        "promptType": "define",
        "text": "={{ JSON.stringify({topic: $('Research Brief').item.json.topic, question: $('Research Brief').item.json.research_question, search: $json}) }}",
        "options": {
          "systemMessage": "You are the industry researcher in an AI Research War Room. Analyze only the supplied search results. Look for adoption signals, real company examples, business impact, hiring/workflow implications, and current trends. Do not invent facts. Return findings, evidence, source URLs, confidence, and unknowns."
        }
      },
      "id": "35e02569-1a1d-429b-8da5-3da2992dfe09",
      "name": "Industry Research Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
